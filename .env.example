# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to git. Keep its permissions at 600.

# Slack bot token (starts with xoxb-), from your Slack App settings.
SLACK_BOT_TOKEN=xoxb-replace-with-your-slack-bot-token

# Slack app-level token (starts with xapp-), needed for Socket Mode.
SLACK_APP_TOKEN=xapp-replace-with-your-slack-app-token

# Discord bot token, from the Discord Developer Portal.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# Discord server (guild) ID that receives the mirrored messages.
DISCORD_GUILD_ID=replace-with-your-discord-guild-id

# When true, the bot creates a Discord channel automatically if the
# paired channel does not exist yet. Requires the Manage Channels
# permission. Allowed values: true / false.
AUTO_CREATE_CHANNELS=false

# When true (the default), on startup the bot joins every public
# Slack channel it is not a member of yet, and joins new public
# channels as they are created. This removes the manual /invite step
# for public channels. It requires the channels:join bot scope in the
# Slack App; without that scope the bot logs one clear warning and
# keeps running (manual invites are then still needed). Private
# channels can never be auto-joined: Slack requires a channel member
# to invite the bot with /invite. Allowed values: true / false.
AUTO_JOIN_PUBLIC_CHANNELS=true

# Maximum file size, in megabytes, that is re-uploaded to Discord.
# Larger files are forwarded as a text note with the file name.
DISCORD_MAX_FILE_MB=25

# Log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
